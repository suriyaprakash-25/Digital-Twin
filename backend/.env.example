# ==============================================================================
# DrivePortz Backend Environment Configuration Template (.env.example)
# ==============================================================================

# Node Environment ('development' | 'staging' | 'production')
NODE_ENV=development
PORT=5000

# MongoDB Database Connection
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>.mongodb.net
MONGO_DB_NAME=driveportz

# Authentication & Security (Min 32 characters in production)
JWT_SECRET_KEY=replace-with-a-secure-secret-key-at-least-32-chars
JWT_EXPIRES_IN=7d

# Frontend Deployment URL & CORS Allowed Origins
FRONTEND_URL=https://www.driveportz.com

# Razorpay Payment Gateway (TEST MODE)
# Test Key starts with rzp_test_
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=placeholder_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=placeholder_razorpay_webhook_secret

# Settlement & Payout Safety Configuration
# Keep MOCK_TEST_MODE=true for testing without real bank disbursements
SETTLEMENT_MODE=MOCK_TEST_MODE
SETTLEMENT_PROVIDER=mock
MIN_SETTLEMENT_AMOUNT=500
HIGH_VALUE_SETTLEMENT_THRESHOLD=50000
MAX_SETTLEMENT_RETRIES=5

# Platform Commission
PLATFORM_COMMISSION_RATE=5
PLATFORM_COMMISSION_TYPE=PERCENTAGE

# Payment Risk Engine Configuration
PAYMENT_RISK_ENABLED=true
PAYMENT_MAX_ATTEMPTS_PER_INVOICE=5
PAYMENT_ATTEMPT_WINDOW_MINUTES=15
PAYMENT_MAX_REFUNDS_PER_PAYMENT=5
DISPUTE_RISK_THRESHOLD=3
HIGH_VALUE_PAYMENT_THRESHOLD=100000
REFUND_RISK_THRESHOLD_PERCENT=80

# Settlement SLA Configuration (Hours)
SETTLEMENT_REVIEW_SLA_HOURS=24
SETTLEMENT_PROCESSING_SLA_HOURS=48
SETTLEMENT_FAILURE_SLA_HOURS=12

# Email Delivery (SMTP for production or Mock for testing)
EMAIL_PROVIDER=mock
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=driveportz3@gmail.com
SMTP_PASS=placeholder_smtp_app_password
SMTP_FROM_EMAIL=driveportz3@gmail.com

# AI & External Integrations (Optional)
GROQ_API_KEY=placeholder_groq_api_key
GEMINI_API_KEY=placeholder_gemini_api_key
GOOGLE_CLIENT_ID=placeholder_google_client_id.apps.googleusercontent.com
GOOGLE_MAPS_API_KEY=placeholder_google_maps_api_key

# Cloudinary Storage (Optional)
CLOUDINARY_CLOUD_NAME=placeholder_cloud_name
CLOUDINARY_API_KEY=placeholder_cloudinary_api_key
CLOUDINARY_API_SECRET=placeholder_cloudinary_api_secret

# Firebase Push Notifications (Optional)
FIREBASE_SERVICE_ACCOUNT_PATH=
